# ===========================================
# MEDSC - Variables de Entorno (EJEMPLO)
# ===========================================
# ⚠️  INSTRUCCIONES:
#     1. Copia este archivo como .env
#     2. Genera nuevas claves seguras para todos los campos marcados con [GENERAR]
#     3. NUNCA commits el archivo .env real a git
# ===========================================

# Enable Database
USE_DATABASE=true

# MySQL Database Configuration
# [GENERAR] Usa: python -c "import secrets; print(secrets.token_urlsafe(16))"
MYSQL_ROOT_PASSWORD=<GENERAR_CONTRASEÑA_SEGURA>
MYSQL_DATABASE=medsc_db
MYSQL_USER=medsc_user
MYSQL_PASSWORD=<GENERAR_CONTRASEÑA_SEGURA>
MYSQL_HOST=db
MYSQL_PORT=3306

# Supabase Configuration
# Obtén estas credenciales de tu proyecto en https://supabase.com
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_anon_key_aqui

# Flask Secret Key
# [GENERAR] Usa: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=<GENERAR_CLAVE_SECRETA>

# ===========================================
# Encriptación de Datos Sensibles (Fernet/AES)
# ===========================================
# Esta clave se usa para encriptar campos sensibles en la base de datos
# [GENERAR] Usa: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 
# ⚠️  CRÍTICO: 
#     - Si pierdes esta clave, los datos encriptados serán IRRECUPERABLES
#     - Guarda un backup seguro de esta clave fuera del servidor
#     - NUNCA cambies esta clave después de tener datos encriptados
ENCRYPTION_KEY=<GENERAR_CLAVE_FERNET>

# ===========================================
# Configuración de Seguridad Adicional
# ===========================================
# Entorno: development | staging | production
FLASK_ENV=development

# Modo debug (NUNCA activar en producción)
FLASK_DEBUG=false
