# ===========================================
# MEDSC - Variables de Entorno (Ejemplo)
# ===========================================
# Copia este archivo como .env y completa los valores

# Enable Database (true para usar MySQL, false para SQLite en memoria)
USE_DATABASE=true

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=tu_password_root_seguro
MYSQL_DATABASE=medsc_db
MYSQL_USER=medsc_user
MYSQL_PASSWORD=tu_password_seguro
MYSQL_HOST=db
MYSQL_PORT=3306

# Supabase Configuration
# Obtén estos valores desde tu proyecto en https://supabase.com
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_supabase_anon_key_aqui

# Flask Secret Key (genera una clave segura para producción)
SECRET_KEY=genera_una_clave_secreta_segura_aqui
